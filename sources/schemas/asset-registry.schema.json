{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/jubilant-waffle/asset-registry.schema.json",
  "title": "Imported project assets",
  "type": "object",
  "required": ["schemaVersion", "assets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["assetId", "type", "localPath", "title", "sourceName", "sourceUrl", "originalAssetId", "author", "license", "licenseUrl", "attribution", "modified", "modificationDescription", "allowedOffline", "allowedRedistribution", "medicalReviewed", "reviewedAt", "importedAt"],
        "properties": {
          "assetId": { "type": "string", "minLength": 1 },
          "type": { "enum": ["glb", "gltf", "texture", "image", "pathology_slide", "ecg", "audio", "ct", "mri", "svg", "icon", "other_media"] },
          "localPath": { "type": "string", "minLength": 1 },
          "title": { "type": "object", "required": ["zh-CN", "en"], "properties": { "zh-CN": { "type": "string" }, "en": { "type": "string" } }, "additionalProperties": false },
          "sourceName": { "type": "string", "minLength": 1 },
          "sourceUrl": { "type": "string", "format": "uri" },
          "originalAssetId": { "type": "string", "minLength": 1 },
          "author": { "type": "string", "minLength": 1 },
          "license": { "type": "string", "minLength": 1 },
          "licenseUrl": { "type": "string", "format": "uri" },
          "attribution": { "type": "string", "minLength": 1 },
          "modified": { "type": "boolean" },
          "modificationDescription": { "type": "string" },
          "allowedOffline": { "type": "boolean" },
          "allowedRedistribution": { "type": "boolean" },
          "medicalReviewed": { "type": "boolean" },
          "reviewedAt": { "type": ["string", "null"], "format": "date" },
          "importedAt": { "type": "string", "format": "date" },
          "licenseStatus": { "enum": ["verified", "pending_license_review", "restricted", "rejected"] },
          "verificationStatus": { "enum": ["verified", "pendingVerification", "rejected"] },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
